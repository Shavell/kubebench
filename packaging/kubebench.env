# KubeBench server configuration, read by kubebench.service (systemd
# EnvironmentFile: KEY=value lines; quote values with spaces in "...").
#
# Every setting is optional; each commented line shows the default.
# Apply changes with: sudo systemctl restart kubebench
# Reference: https://github.com/Shavell/kubebench/blob/main/docs/deployment.md#configuration
#
# This file can hold the bootstrap password and a kubeconfig path: keep it
# root:kubebench 0640.

# HTTP port.
#PORT=9876

# Full bind address; overrides PORT. 127.0.0.1:9876 keeps the UI local
# (behind a reverse proxy or an SSH tunnel).
#KUBEBENCH_LISTEN_ADDR=:9876

# SQLite database and the writable state directory (Helm repository cache,
# chart uploads, external plugins). The systemd unit sets both to
# /var/lib/kubebench; moving them also needs ReadWritePaths= in a unit drop-in.
#KUBEBENCH_DB=/var/lib/kubebench/kubebench.db
#KUBEBENCH_DATA_DIR=/var/lib/kubebench

# External (frontend) plugins.
#KUBEBENCH_PLUGINS_DIR=/var/lib/kubebench/plugins

# Password of the bootstrap "admin" user, used on the very first start only
# (8 characters to 72 bytes). When unset the password is "admin" and must be
# changed at the first sign-in.
#KUBEBENCH_ADMIN_PASSWORD=

# Secure attribute of the session cookie: auto (when the request is TLS, or
# carries a trusted X-Forwarded-Proto: https), true or false.
#KUBEBENCH_SECURE_COOKIES=auto

# Honour X-Forwarded-Proto/X-Forwarded-For. Enable only behind a reverse proxy.
#KUBEBENCH_TRUST_PROXY=false

# Serve HTTPS directly. Both files must be readable by the kubebench user,
# e.g. /etc/kubebench/tls.crt and /etc/kubebench/tls.key (root:kubebench 0640).
#KUBEBENCH_TLS_CERT=
#KUBEBENCH_TLS_KEY=

# Session lifetime (Go duration, at least 1m).
#KUBEBENCH_SESSION_TTL=168h

# Audit log rows older than this many days are pruned daily (0 = keep forever).
#KUBEBENCH_AUDIT_RETENTION_DAYS=90

# Allow admins to add clusters by a kubeconfig path on this machine.
#KUBEBENCH_ALLOW_PATH_KUBECONFIG=true

# Let pasted kubeconfigs run exec credential plugins and auth providers and
# read files on this machine. Every admin can then run commands as the
# kubebench user. Kubeconfigs added by path may always use them. (The EKS,
# GKE and AKS plugins are never run; see the next setting.)
#KUBEBENCH_ALLOW_KUBECONFIG_EXEC=false

# Let pasted EKS, GKE and AKS kubeconfigs sign in with this machine's own
# cloud identity (instance profile, VM service account, managed identity,
# AWS_*/AZURE_* variables, ~/.aws and gcloud files). Every admin can then
# obtain that identity's token. Without it, such clusters need per-cluster
# credentials.
#KUBEBENCH_ALLOW_AMBIENT_CLOUD_IDENTITY=false

# Kubeconfig that seeds the cluster inventory on the first start
# (install.sh --kubeconfig copies one to /etc/kubebench/kubeconfig); a list
# such as a:b is merged the way kubectl merges it.
#KUBECONFIG=

# A namespace KubeBench refuses to delete unless forced, as if it ran there
# (inside a cluster this is the pod's own namespace).
#KUBEBENCH_NAMESPACE=

# Default update check: stable (new releases on GitHub), prerelease (also
# prereleases) or off (never contacts GitHub; use it without internet access,
# install.sh --offline sets it). Administrators can change it in Settings.
# The check honours HTTPS_PROXY and NO_PROXY.
#KUBEBENCH_UPDATE_MODE=stable

# Releases list the update check reads (GitHub's "list releases" JSON); point
# it at a mirror inside the network if you have one.
#KUBEBENCH_UPDATE_URL=https://api.github.com/repos/Shavell/kubebench/releases

# Service browser (Services: Open in browser): a separate origin, e.g.
# https://kubebench-proxy.example.net, that serves the proxied pages
# unsandboxed, isolated from KubeBench by the origin. Point that host name at
# this server as well (DNS, reverse proxy, certificate). It must be a host on
# another domain than KubeBench's: not the same host with another port, not a
# subdomain (cookies ignore ports; KubeBench refuses such an origin). Unset:
# pages run sandboxed on KubeBench's own origin (some apps, e.g. ones with a
# sign-in, do not work).
#KUBEBENCH_PROXY_ORIGIN=

# External identities (docs/configuration.md#external-identities-oidc).
# The URL users reach KubeBench at; the OIDC redirect URL is
# <KUBEBENCH_PUBLIC_URL>/api/auth/oidc/callback.
#KUBEBENCH_PUBLIC_URL=https://kubebench.example.com
# Refuse external users whose groups grant nothing (false: they see no cluster).
#KUBEBENCH_AUTH_REQUIRE_GROUP=false
# Group mappings seeded on the first start that has them (JSON); admins
# manage them in Settings > Authentication afterwards.
#KUBEBENCH_AUTH_GROUP_MAPPINGS=[{"group":"kubebench-admins","role":"admin"},{"group":"sre","role":"operator","cluster":"prod"}]
# OpenID Connect sign-in ("Sign in with <KUBEBENCH_OIDC_NAME>").
#KUBEBENCH_OIDC_ISSUER=https://sso.example.com/realms/platform
#KUBEBENCH_OIDC_CLIENT_ID=kubebench
# The client secret: prefer a file readable by the kubebench user only
# (or a systemd credential) over the variable itself.
#KUBEBENCH_OIDC_CLIENT_SECRET_FILE=/etc/kubebench/oidc-client-secret
#KUBEBENCH_OIDC_CLIENT_SECRET=
#KUBEBENCH_OIDC_NAME=SSO
#KUBEBENCH_OIDC_SCOPES=openid profile email
#KUBEBENCH_OIDC_USERNAME_CLAIM=preferred_username
#KUBEBENCH_OIDC_GROUPS_CLAIM=groups
#KUBEBENCH_OIDC_ALLOWED_DOMAINS=
# PEM CA bundle for the provider's certificate (TLS is always verified).
#KUBEBENCH_OIDC_CA_FILE=
