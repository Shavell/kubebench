# KubeBench server configuration, read by kubebench.service (systemd
# EnvironmentFile: KEY=value lines; quote values with spaces in "...").
#
# Every setting is optional; each commented line shows the default.
# Apply changes with: sudo systemctl restart kubebench
# Reference: https://github.com/Shavell/kube-bench/blob/main/docs/deployment.md#configuration
#
# This file can hold the bootstrap password and a kubeconfig path: keep it
# root:kubebench 0640.

# HTTP port.
#PORT=9876

# Full bind address; overrides PORT. 127.0.0.1:9876 keeps the UI local
# (behind a reverse proxy or an SSH tunnel).
#KUBEBENCH_LISTEN_ADDR=:9876

# SQLite database and the writable state directory (Helm repository cache,
# chart uploads, external plugins). The systemd unit sets both to
# /var/lib/kubebench; moving them also needs ReadWritePaths= in a unit drop-in.
#KUBEBENCH_DB=/var/lib/kubebench/kubebench.db
#KUBEBENCH_DATA_DIR=/var/lib/kubebench

# External (frontend) plugins.
#KUBEBENCH_PLUGINS_DIR=/var/lib/kubebench/plugins

# Password of the bootstrap "admin" user, used on the very first start only.
# When unset the password is "admin" and must be changed at the first sign-in.
#KUBEBENCH_ADMIN_PASSWORD=

# Secure attribute of the session cookie: auto (when the request is TLS, or
# carries a trusted X-Forwarded-Proto: https), true or false.
#KUBEBENCH_SECURE_COOKIES=auto

# Honour X-Forwarded-Proto/X-Forwarded-For. Enable only behind a reverse proxy.
#KUBEBENCH_TRUST_PROXY=false

# Serve HTTPS directly. Both files must be readable by the kubebench user,
# e.g. /etc/kubebench/tls.crt and /etc/kubebench/tls.key (root:kubebench 0640).
#KUBEBENCH_TLS_CERT=
#KUBEBENCH_TLS_KEY=

# Session lifetime (Go duration, at least 1m).
#KUBEBENCH_SESSION_TTL=168h

# Audit log rows older than this many days are pruned daily (0 = keep forever).
#KUBEBENCH_AUDIT_RETENTION_DAYS=90

# Allow admins to add clusters by a kubeconfig path on this machine.
#KUBEBENCH_ALLOW_PATH_KUBECONFIG=true

# Kubeconfig that seeds the cluster inventory on the first start
# (install.sh --kubeconfig copies one to /etc/kubebench/kubeconfig).
#KUBECONFIG=

# A namespace KubeBench refuses to delete unless forced, as if it ran there
# (inside a cluster this is the pod's own namespace).
#KUBEBENCH_NAMESPACE=
